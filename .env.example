# Copy this file to .env and fill it in. Never commit your .env.
# Generate random secrets with:  openssl rand -hex 32

# ---- Dashboard login (required) ----
# Your account is created from these on the first start. Change the password later in "My account".
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# ---- Secrets (required) ----
# SESSION_SECRET signs login sessions. SECRETS_KEY encrypts the API keys and tokens stored in MySQL:
# set it once and NEVER change it (stored keys would become unreadable).
SESSION_SECRET=
SECRETS_KEY=

# ---- Address ----
PORT=3000
# Public address of the dashboard, used for the "Continue with Facebook" redirect.
# Local: http://localhost:3000   Server: https://your-domain.com
PUBLIC_URL=http://localhost:3000

# ---- MySQL (required) ----
# Docker Compose starts MySQL for you with these values (DB_HOST is set automatically there).
# Without Docker, point these at your own MySQL 8 server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pixgen
DB_PASSWORD=
DB_NAME=fb_autopilot
# Docker Compose only: root password of the bundled MySQL container
MYSQL_ROOT_PASSWORD=

# ---- Optional: can also be set later in the dashboard ----
# Gemini key: https://aistudio.google.com/apikey  (copied into Integrations on first start)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Facebook App for "Continue with Facebook" (normally entered in Platform settings)
# FB_APP_ID=
# FB_APP_SECRET=

# ---- Defaults for new pages (each page can change them in the dashboard) ----
PAGE_NICHE=Technology, AI, Business & Digital Productivity
BRAND_NAME=My Page Name
BRAND_HANDLE=@mypagehandle
BRAND_LOGO_URL=
# Keep the quotes: without them dotenv reads # as a comment
PRIMARY_COLOR="#0f172a"
ACCENT_COLOR="#38bdf8"
# Cron format: minute hour day month weekday. "0 10 * * *" = every day at 10:00
CRON_SCHEDULE=0 10 * * *
TIMEZONE=Asia/Dhaka

# ---- Advanced ----
# Docker Compose: port on your machine/server
# HOST_PORT=3000
# FB_GRAPH_VERSION=v21.0
# BIND_HOST=0.0.0.0
# DB_POOL_SIZE=10
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
